package com.example.demo;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestHeader;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.example.demo.model.service.JWTService;
import com.example.demo.model.service.PaymentService;

@CrossOrigin
@RestController
@RequestMapping("Payment")
public class PaymentController {
	
	@Autowired
	JWTService Jwts;
	
	@Autowired
	PaymentService ps;
	
	@PostMapping("createpayment")
	public Object createpayment(@PathVariable int enrolmentid, @PathVariable int amount,@PathVariable String status, @RequestHeader String token) {
		return ps.createPayment(enrolmentid,amount,status,token);
	}

}
