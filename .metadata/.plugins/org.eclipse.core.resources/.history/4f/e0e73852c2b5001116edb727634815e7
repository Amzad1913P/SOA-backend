package com.example.demo.model.service;

import java.util.HashMap;
import java.util.Map;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import com.example.demo.model.Enrolment;
import com.example.demo.model.repository.EnrolmentRepository;

@Service
public class EnrolmentService {
	@Autowired
	EnrolmentRepository repo;
	
	JWTService Jwts;
	
	
	public Object enrol(int courseid,int instructorid, String token) {
		Map<String, String> response = new HashMap<>();
		Enrolment enrolment=new Enrolment();
		try {
			Map<String, String> parsedJWT = Jwts.validateJWT(token);
			enrolment.setCourse_id(courseid);
			enrolment.setUser_id(Integer.parseInt(parsedJWT.get("id")));
			enrolment.setInstructor_id(instructorid);
			repo.save(enrolment);
			response.put("message", "Course created successfully by MS2.1");
		}

		catch (Exception e) {
			response.put("code", "501");
			response.put("message", e.getMessage());
		}
		return response;
	}
	
	public Object getEnroled(int userid, String token) {
		Map<String, Object> response = new HashMap<>();
		try {
			Map<String, String> parsedJWT = Jwts.validateJWT(token);
			int loggeduserid = Integer.parseInt(parsedJWT.get("id"));
			if (loggeduserid != userid) {
				response.put("code", "403");
				response.put("message", "Unauthorized");
				return response;
			}
			java.util.List<Enrolment> enrolments = repo.findByUser_id(userid);
			response.put("code", "200");
			response.put("enrolments", enrolments);
		}
		catch (Exception e) {
			response.put("code", "501");
			response.put("message", e.getMessage());
		}
		return response;
	}

	public Object deleteEnrolment(int courseid, String token) {
		Map<String, String> response = new HashMap<>();
		try {
			Map<String, String> parsedJWT = Jwts.validateJWT(token);
			int userid = Integer.parseInt(parsedJWT.get("id"));
			repo.deleteByUser_idAndCourse_id(userid, courseid);
			response.put("code", "200");
			response.put("message", "Course dropped successfully");
		}
		catch (Exception e) {
			response.put("code", "501");
			response.put("message", e.getMessage());
		}
		return response;
	}

}
